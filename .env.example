# Your private key (with 0x prefix or without). Keep this secret!
PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE

# Arbitrum Sepolia RPC Endpoint
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Slippage tolerance in basis points (100 = 1.0%, 50 = 0.5%)
SLIPPAGE_BPS=100

# Configured random wait interval in seconds (default: 5 - 15 seconds)
# Note: Stabilizer has a 10s cooldown for qualifying swap points.
MIN_WAIT_SECONDS=5
MAX_WAIT_SECONDS=15

# Total number of full cycles to execute (leave empty or omit for infinite continuous loop)
# MAX_CYCLES=50

# Daily Points Cap Configuration
DAILY_POINT_CAP=20000
STOP_ON_DAILY_CAP=true

# If true, the bot will sleep until 00:00 UTC when the cap is reached, then automatically resume.
# If false, the bot will cleanly exit when the cap is reached.
SLEEP_UNTIL_MIDNIGHT_UTC=false
